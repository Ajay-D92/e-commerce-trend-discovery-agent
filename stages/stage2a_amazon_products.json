        "jsCode": "// Reshape FastAPI response to legacy { amazonProducts } shape\n// expected by Merge All Data1 and the downstream AI stages (Stages 3–7).\nconst r = $input.first().json;\nconst products = r.products || [];\n\nreturn [{\n  json: {\n    amazonProducts: products.map(p => ({\n      url: p.url,\n      name: p.name,\n      price: p.price,\n      details: p.details || [],\n      pattern: p.pattern || '',\n      image_url: p.image_url || '',\n      rating: p.rating || '',\n      review_count: p.review_count || '',\n      scraped_at: r.scraped_at || new Date().toISOString()\n    })),\n    totalProducts: products.length,\n    scrapedAt: r.scraped_at || new Date().toISOString()\n  }\n}];"
